# Copy to .env on RunPod (or export in tmux). Do not commit real secrets.

# Weights & Biases — https://wandb.ai/settings
WANDB_API_KEY=your_wandb_api_key
WANDB_PROJECT=transformer-en-hi
# WANDB_ENTITY=your-team-or-username

# Slack Incoming Webhook — https://api.slack.com/messaging/webhooks
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXXXXXX
# monitoring.webhook_type in YAML should be "slack"

# Optional overrides
# ALERT_WEBHOOK_TYPE=slack
